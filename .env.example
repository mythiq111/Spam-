# Copy to .env for local use. On Vercel, add these in Project Settings > Environment Variables.

FRIEND_NAME=Her Name
MY_NAME=Your Name

# Digits only with country code, e.g. 919876543210. Leave empty to hide the WhatsApp button.
MY_WHATSAPP=

# Password she must enter before the photos page opens.
GALLERY_PASSWORD=

# Email alert when she answers, sent with Resend (https://resend.com).
# API key: Resend dashboard > API Keys. The domain must be verified in Resend > Domains.
RESEND_API_KEY=
# Must be an address on your verified domain, e.g. Sorry <sorry@yourdomain.com>
RESEND_FROM=
# Where the alert goes (your own inbox). Separate several with commas.
NOTIFY_EMAIL=

# Optional: get a phone notification the moment she answers.
# Install the free "ntfy" app, subscribe to a long random topic name, and put it here.
NTFY_TOPIC=
